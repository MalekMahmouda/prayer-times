{
  "name": "prayertimes",
  "productName": "Prayer Times",
  "version": "1.0.0",
  "description": "Islamic desktop companion with prayer times, Quran, Dhikr and Qibla.",
  "main": "main/main.js",
  "author": "Malek",
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "assets": "node scripts/gen-assets.js",
    "package": "electron-builder",
    "package:dir": "electron-builder --dir",
    "package:installer": "electron-builder --win nsis",
    "release": "node scripts/make-release.js"
  },
  "build": {
    "appId": "com.malek.prayertimes",
    "productName": "Prayer Times",
    "copyright": "Copyright © 2026 Malek",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main/**/*",
      "js/**/*",
      "styles/**/*",
      "data/**/*",
      "assets/**/*",
      "prayer-times.html",
      "adhan.html",
      "widget.html",
      "preload.js",
      "widget-preload.js",
      "main/overlay-preload.js",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "artifactName": "Prayer-Times-Setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Prayer Times",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "Prayer Times ${version}"
    }
  },
  "dependencies": {
    "adhan": "^4.4.3"
  },
  "devDependencies": {
    "electron": "^41.1.0",
    "electron-builder": "^26.0.12",
    "pngjs": "^7.0.0"
  }
}
